{
  "name": "tank-arena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "description": "Multiplayer browser tank game: Colyseus server, PixiJS + React client",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @tank-arena/server --filter @tank-arena/client run dev",
    "dev:server": "pnpm --filter @tank-arena/server run dev",
    "dev:client": "pnpm --filter @tank-arena/client run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0"
  }
}
