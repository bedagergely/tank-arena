{
  "name": "tank-arena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "type": "module",
  "description": "Multiplayer browser tank game: Colyseus server, PixiJS + React client",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "scripts": {
    "dev": "bun --bun run --parallel --filter @tank-arena/server --filter @tank-arena/client run dev",
    "dev:server": "bun --bun run --filter @tank-arena/server run dev",
    "dev:client": "bun --bun run --filter @tank-arena/client run dev",
    "build": "bun --bun run --workspaces --if-present build",
    "test": "bun --bun run --workspaces --if-present test",
    "typecheck": "bun --bun run --workspaces --if-present typecheck",
    "lint": "bun --bun run eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0"
  }
}
